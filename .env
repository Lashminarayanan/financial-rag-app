
# =========================
# Shared configuration
# =========================

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=financial_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

REPORTS_DIR=./sample_data/reports
EMBEDDING_DIM=768

# =========================
# Parsing options
# =========================
# Recommended for MVP:
# USE_DOCLING=false
# This avoids OCR-heavy Docling preprocessing and uses PyPDF by default.
USE_DOCLING=true
DOCLING_PREFER=false

AUTO_PARSER_ROUTE=true
MAX_PROBE_PAGES=10

MIN_AVG_CHARS_PER_PAGE=250
MAX_EMPTY_PAGE_RATIO=0.30
TABLE_SIGNAL_RATIO_THRESHOLD=0.35
TABLE_EXTRACTION_PRIORITY=true
# =========================
# Backend / UI
# =========================

PYTHON_QUERY_WORKER=C:/Program Files/Python313/python.exe
RAG_PYTHON_ENTRY=../rag/app/query_worker.py

BACKEND_PORT=8080
STREAMLIT_BACKEND_URL=http://localhost:8080
